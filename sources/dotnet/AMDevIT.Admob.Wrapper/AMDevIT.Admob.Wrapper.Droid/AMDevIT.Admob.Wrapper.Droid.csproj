<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsAMDevITAdMobPackage>true</IsAMDevITAdMobPackage>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>33.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<Description>AdMob binding library for Android. It allows to use the AdMob library directly from a dotnet Android application project. Or can be used to implement a custom handler in MAUI. </Description>
    <!--
      Enable trim analyzers for Android class libraries.
      To learn more, see: https://learn.microsoft.com/dotnet/core/deploying/trimming/prepare-libraries-for-trimming
    -->
    <IsTrimmable>true</IsTrimmable>
    <Title>AMDev.IT AdMob binding library for Android</Title>
    <PackageTags>AdMob;Binding;MAUI;Google;Advertising;Monetization;Android</PackageTags>
    <PackageIcon>admob_maui_icon_v4_wallet_block.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>	
	 <!--<VersionPrefix>0.1.10</VersionPrefix>
	 <VersionSuffix></VersionSuffix>-->

	  <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

	<ItemGroup>
		<AndroidNamespaceReplacement Include="it.amdev.admob.wrapper" Replacement="AMDevIT.Admob.Wrapper" />
	</ItemGroup>
	
  <ItemGroup>
    <Folder Include="Jars\" />
  </ItemGroup>

  <ItemGroup>
	  <AndroidMavenLibrary Include="com.google.android.libraries.ads.mobile.sdk:ads-mobile-sdk" Version="1.3.1" Repository="Google" Bind="false" />
	  <AndroidMavenLibrary Include="com.google.android.play:hsdp" Version="2.0.1" Repository="Google" Bind="false" />
	  <PackageReference Include="Xamarin.AndroidX.Activity" Version="1.13.0.1" />
	  <PackageReference Include="Xamarin.AndroidX.Annotation" Version="1.10.0.1" />
	  <PackageReference Include="Xamarin.AndroidX.AppCompat.AppCompatResources" Version="1.7.1.4" />
	  <PackageReference Include="Xamarin.AndroidX.Browser" Version="1.10.0.1" />
	  <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.0.1" />
	  <PackageReference Include="Xamarin.AndroidX.Core" Version="1.19.0.1" />
	  <PackageReference Include="Xamarin.AndroidX.DataStore" Version="1.2.1.1" />
	  <PackageReference Include="Xamarin.AndroidX.Lifecycle.Common.Jvm" Version="2.11.0.1" />
	  <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Android" Version="2.11.0.1" />
	  <PackageReference Include="Xamarin.AndroidX.NavigationEvent.Android" Version="1.1.2.1" />
	  <PackageReference Include="Xamarin.AndroidX.PrivacySandbox.Ads.AdsServices" Version="1.1.0.6-beta12" />
	  <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Android" Version="1.5.0.1" />
	  <PackageReference Include="Xamarin.AndroidX.WebKit" Version="1.16.0.1" />
	  <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.11.2.1" />
	  <PackageReference Include="Xamarin.GooglePlayServices.Ads.Identifier" Version="118.3.0.2" />
	  <PackageReference Include="Xamarin.GooglePlayServices.AppSet" Version="116.1.0.10" />
	  <PackageReference Include="Xamarin.GooglePlayServices.Basement" Version="118.10.0.2" />
	  <PackageReference Include="Xamarin.GooglePlayServices.CroNet" Version="118.1.1.3" />
	  <PackageReference Include="Xamarin.GooglePlayServices.Tasks" Version="118.4.1.2" />
	  <PackageReference Include="Xamarin.Google.UserMessagingPlatform" Version="4.0.0.3" />
	  <PackageReference Include="GoogleGson" Version="2.14.0.1" />
	  <PackageReference Include="Xamarin.Google.Crypto.Tink.Android" Version="1.23.0" />
	  <PackageReference Include="Xamarin.Google.Guava" Version="33.6.0.1" />
	  <PackageReference Include="Square.OkHttp3" Version="5.4.0.1" />
	  <PackageReference Include="Xamarin.Chromium.CroNet.Api" Version="143.7445.0.2" />
	  <PackageReference Include="Xamarin.Chromium.CroNet.Fallback" Version="143.7445.0.2" />
	  <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.4.0.1" />
	  <PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="1.11.0.1" />
	  <PackageReference Include="Xamarin.KotlinX.Coroutines.Guava" Version="1.11.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Jars\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\..\assets\icons\png\admob_maui_icon_v4_wallet_block.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>
